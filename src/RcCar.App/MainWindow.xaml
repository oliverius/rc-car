<Window x:Class="RcCar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RC Car" Width="1120" Height="930" MinWidth="900" MinHeight="720"
        Background="#F2F5F9" Foreground="#16243A" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20,8,20,16" Background="#F2F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="176" />
            <RowDefinition Height="190" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="RC Car" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" />
        </DockPanel>
        <Border Grid.Row="1" Background="#E3ECFC" CornerRadius="8" Padding="10" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Stop" ToolTip="Stop session (Esc)" Command="{Binding StopCommand}" Margin="12,0,0,0" Padding="12,6" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="01 / Connect" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Turn the car and remote OFF. Start discovery, then turn the car ON at PUBLISHER READY." Margin="0,0,0,12" />
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="Check Bluetooth adapter" Command="{Binding InspectCommand}" />
                            <TextBlock Grid.Column="1" Text="{Binding AdapterText}" Foreground="#586981" FontSize="12"
                                       Margin="8,0,0,8" VerticalAlignment="Center" />
                            <Button Grid.Row="1" Content="Discover cars" Command="{Binding DiscoverCommand}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,8"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Selected car" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding Cars}" SelectedItem="{Binding SelectedCar}" DisplayMemberPath="DisplayName"
                                          IsEnabled="{Binding CanSelect}" Width="190" MinHeight="34" AutomationProperties.Name="Selected car" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Multiple candidates require your selection." Foreground="#586981" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="02 / Diagnose" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Lift the wheels and keep the power switch reachable. Turn the car OFF before each test." Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button Content="Forward pulse" Command="{Binding ForwardCommand}" />
                            <Button Content="Steering test" Command="{Binding SteeringCommand}" />
                            <Button Content="Reverse pulse" Command="{Binding ReverseCommand}" />
                        </WrapPanel>
                        <TextBlock Text="Tests end with repeated neutral." Foreground="#586981" FontSize="12" Margin="0,0,0,12" />
                        <Expander Header="Record what happened" IsExpanded="{Binding ObservationExpanded}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding LastTest}" FontWeight="SemiBold" />
                                <TextBox Text="{Binding Observation, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="54" Margin="0,8,0,8"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Physical observation" />
                                <Button Content="Save observation" Command="{Binding SaveObservationCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
        <Border Grid.Row="3" Background="#172B49" CornerRadius="10" Padding="16" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="540" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="03 / Drive" Foreground="White" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Turn the car OFF, enable driving, then turn it ON at PUBLISHER READY." Foreground="#D9E6FA" Margin="0,0,0,8" />
                    <TextBlock Text="Neutral on release · Space changes gear · Esc stops" Foreground="#B8CAE3" FontSize="12" />
                </StackPanel>
                <Grid Grid.Column="1" Margin="16,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Throttle" Foreground="#B8CAE3" FontSize="11" HorizontalAlignment="Center" />
                            <Border Background="#233D63" CornerRadius="8" Padding="6" Margin="0,3,0,0"
                                    AutomationProperties.Name="Throttle controls">
                                <Grid Width="92" Height="112">
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <Button Grid.Row="0" Content="▲" Margin="2" Padding="0" FontSize="24"
                                            ClickMode="Press" IsEnabled="{Binding IsDriving}"
                                            PreviewMouseLeftButtonDown="OnForwardMouseDown"
                                            PreviewMouseLeftButtonUp="OnDriveButtonMouseUp"
                                            LostMouseCapture="OnDriveButtonLostMouseCapture">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="#315581" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ForwardPressed}" Value="True">
                                                        <Setter Property="Background" Value="#8EE3C3" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#8EE3C3" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Row="2" Content="▼" Margin="2" Padding="0" FontSize="24"
                                            ClickMode="Press" IsEnabled="{Binding IsDriving}"
                                            PreviewMouseLeftButtonDown="OnReverseMouseDown"
                                            PreviewMouseLeftButtonUp="OnDriveButtonMouseUp"
                                            LostMouseCapture="OnDriveButtonLostMouseCapture">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="#315581" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ReversePressed}" Value="True">
                                                        <Setter Property="Background" Value="#8EE3C3" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#8EE3C3" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Steering" Foreground="#B8CAE3" FontSize="11" HorizontalAlignment="Center" />
                            <Border Background="#233D63" CornerRadius="8" Padding="6" Margin="0,3,0,0"
                                    AutomationProperties.Name="Steering controls">
                                <Grid Width="132" Height="92">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="◀" Margin="2" Padding="0" FontSize="24"
                                            ClickMode="Press" IsEnabled="{Binding IsDriving}"
                                            PreviewMouseLeftButtonDown="OnLeftMouseDown"
                                            PreviewMouseLeftButtonUp="OnDriveButtonMouseUp"
                                            LostMouseCapture="OnDriveButtonLostMouseCapture">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="#315581" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LeftPressed}" Value="True">
                                                        <Setter Property="Background" Value="#8EE3C3" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#8EE3C3" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="2" Content="▶" Margin="2" Padding="0" FontSize="24"
                                            ClickMode="Press" IsEnabled="{Binding IsDriving}"
                                            PreviewMouseLeftButtonDown="OnRightMouseDown"
                                            PreviewMouseLeftButtonUp="OnDriveButtonMouseUp"
                                            LostMouseCapture="OnDriveButtonLostMouseCapture">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="#315581" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RightPressed}" Value="True">
                                                        <Setter Property="Background" Value="#8EE3C3" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#8EE3C3" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GearText}" Foreground="#8EE3C3" FontWeight="Bold" FontSize="22" />
                        <TextBlock Text="{Binding RequestedState}" Foreground="White" Margin="0,2,0,4" />
                        <Button Content="Enable keyboard driving" Command="{Binding DriveCommand}" HorizontalAlignment="Left" Margin="0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Open session folder" Command="{Binding OpenLogsCommand}"
                            Padding="10,5" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="Session events · complete details and observations are saved automatically"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="EventList" ItemsSource="{Binding Events}" FontFamily="Consolas" FontSize="11"
                         Background="#101C2E" Foreground="#D4E4F5" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Session events" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
