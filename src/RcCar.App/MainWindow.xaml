<Window x:Class="RcCar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RC Car Lab" Width="1120" Height="930" MinWidth="900" MinHeight="720"
        Background="#F2F5F9" Foreground="#16243A" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24" Background="#F2F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="190" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Open session folder" Command="{Binding OpenLogsCommand}" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Text="RC Car Lab" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Explore the protocol. Find your car. Take control." Foreground="#586981" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="#E3ECFC" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Stop session (Esc)" Command="{Binding StopCommand}" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,8,12">
                        <StackPanel>
                            <TextBlock Text="01 / Connect" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Turn the car and remote OFF. Start discovery, then turn the car ON when PUBLISHER READY appears." Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button Content="Check adapter" Command="{Binding InspectCommand}" />
                                <Button Content="Discover cars" Command="{Binding DiscoverCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding AdapterText}" Foreground="#586981" FontSize="12" Margin="0,0,0,12" />
                            <TextBlock Text="Selected car" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Cars}" SelectedItem="{Binding SelectedCar}" DisplayMemberPath="DisplayName"
                                      IsEnabled="{Binding CanSelect}" MinHeight="34" AutomationProperties.Name="Selected car" />
                            <TextBlock Text="Only matching standard-Car replies appear. Multiple candidates require your selection." Foreground="#586981" FontSize="12" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,12">
                        <StackPanel>
                            <TextBlock Text="02 / Diagnose" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Lift the wheels and keep the power switch reachable. Turn the car OFF before each test; switch ON at PUBLISHER READY." Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button Content="Forward pulse" Command="{Binding ForwardCommand}" />
                                <Button Content="Steering test" Command="{Binding SteeringCommand}" />
                                <Button Content="Reverse pulse" Command="{Binding ReverseCommand}" />
                            </WrapPanel>
                            <TextBlock Text="Forward/reverse: speed 20 for 0.3 s. Steering: left, neutral, right. All tests end with repeated neutral." Foreground="#586981" FontSize="12" Margin="0,0,0,12" />
                            <Expander Header="Record what happened" IsExpanded="{Binding ObservationExpanded}">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{Binding LastTest}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding Observation, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="54" Margin="0,8,0,8"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Physical observation" />
                                    <Button Content="Save physical observation" Command="{Binding SaveObservationCommand}" HorizontalAlignment="Left" />
                                    <TextBlock Text="Did it move, stop, and return to centre? Describe the wheels and lights." FontSize="12" Foreground="#586981" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Background="#172B49" CornerRadius="10" Padding="20" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="03 / Drive" Foreground="White" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Turn car OFF, enable driving, then switch ON at PUBLISHER READY." Foreground="#D9E6FA" Margin="0,0,0,12" />
                            <TextBlock Text="↑ Forward    ↓ Reverse    ← Left    → Right" Foreground="White" FontSize="18" Margin="0,0,0,10" />
                            <TextBlock Text="Release arrows: neutral   ·   Space: next gear   ·   Esc: end session" Foreground="#D9E6FA" />
                            <TextBlock Text="Driving is active only after fresh pairing. Losing focus sends neutral; release arrows before resuming." Foreground="#B8CAE3" FontSize="12" Margin="0,8,12,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{Binding GearText}" Foreground="#8EE3C3" FontWeight="Bold" FontSize="24" />
                            <TextBlock Text="{Binding RequestedState}" Foreground="White" Margin="0,8,0,12" />
                            <Button Content="Enable keyboard driving" Command="{Binding DriveCommand}" />
                            <TextBlock Text="Neutral keeps refreshing while idle. Shown state is requested, not car telemetry." Foreground="#B8CAE3" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Session events · complete details and observations are saved automatically" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox x:Name="EventList" ItemsSource="{Binding Events}" FontFamily="Consolas" FontSize="11"
                         Background="#101C2E" Foreground="#D4E4F5" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Session events" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
